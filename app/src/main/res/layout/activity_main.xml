<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#87CEEB">

    <com.endroid.andcraft.gl.GameSurfaceView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:orientation="vertical"
        android:background="#66000000"
        android:padding="8dp">
        <TextView
            android:id="@+id/hudDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="Day 1"/>
        <TextView
            android:id="@+id/hudCombat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFE9A6"
            android:textSize="12sp"
            android:text=""/>
        <TextView
            android:id="@+id/hudInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CCFFFFFF"
            android:textSize="10sp"
            android:text=""/>
        <TextView
            android:id="@+id/quest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="260dp"
            android:layout_marginTop="4dp"
            android:textColor="#9BE08A"
            android:textSize="11sp"
            android:text=""/>
    </LinearLayout>

    <TextView
        android:id="@+id/toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="56dp"
        android:textColor="#FFE9A6"
        android:textSize="14sp"
        android:shadowColor="#000"
        android:shadowRadius="3"
        android:text=""/>

    <TextView
        android:id="@+id/crosshair"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:shadowColor="#000"
        android:shadowRadius="2"/>

    <!-- top right: menu in the corner, craft under it -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:orientation="vertical">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMenu"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="≡"
            android:textSize="24sp"
            app:backgroundTint="#88000000"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCraft"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="CRAFT"
            android:textSize="9sp"
            app:backgroundTint="#88000000"/>
    </LinearLayout>

    <!-- hearts / food above the hotbar -->
    <LinearLayout
        android:id="@+id/stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="64dp"
        android:layout_marginBottom="62dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/hearts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF3B3B"
            android:textSize="14sp"
            android:shadowColor="#000"
            android:shadowRadius="2"/>
        <TextView
            android:id="@+id/foodbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:textColor="#FFB040"
            android:textSize="14sp"
            android:shadowColor="#000"
            android:shadowRadius="2"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="190dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBlocks"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="▦"
            android:textSize="22sp"
            app:cornerRadius="6dp"
            app:backgroundTint="#CC2E7D32"/>
        <HorizontalScrollView
            android:id="@+id/hotbarScroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/hotbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- thumb arc, bottom right: JUMP in the corner, BREAK left of it, PLACE above, EAT between -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnJump"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="JUMP"
        android:textSize="11sp"
        app:cornerRadius="38dp"
        app:backgroundTint="#66000000"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBreak"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="98dp"
        android:layout_marginBottom="20dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="BREAK"
        android:textSize="10sp"
        app:cornerRadius="33dp"
        app:backgroundTint="#66000000"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPlace"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="98dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="PLACE"
        android:textSize="10sp"
        app:cornerRadius="33dp"
        app:backgroundTint="#66000000"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEat"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="98dp"
        android:layout_marginBottom="94dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="EAT"
        android:textSize="9sp"
        app:cornerRadius="26dp"
        app:backgroundTint="#66000000"/>
</FrameLayout>
